# Copier ce fichier en .env et renseigner les valeurs. Ne jamais versionner .env.

# Base de données PostgreSQL
DATABASE_URL=
# true pour vérifier le certificat SSL de la base (false par défaut)
DB_SSL_STRICT=false

# Secret de signature des tokens JWT (long et aléatoire, 32 caractères minimum conseillés)
JWT_SECRET=

# Emails (Resend)
RESEND_API_KEY=
EMAIL_DOMAIN=
FRONTEND_URL=

# Scripts d'administration (create-admin-pg.cjs, check-admin.cjs)
ADMIN_EMAIL=
ADMIN_PASSWORD=
